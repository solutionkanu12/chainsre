# ChainSRE — environment template. Copy to `.env` (and per-app `.env.local`) and fill values.
# NEVER commit a real .env. Only this .env.example (placeholders) is tracked by Git.

#############################################
# Shared / network
#############################################
# Active chain for the MVP demo. Base Sepolia = 84532. Registry is multi-chain ready.
CHAIN_ID=84532

#############################################
# Web (apps/web) — PUBLIC values only. These are exposed to the browser bundle.
#############################################
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org
# Deployed contract addresses (filled in Phase 2). Public, non-secret.
NEXT_PUBLIC_INTENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_PROTECTED_VAULT_ADDRESS=
NEXT_PUBLIC_CONTROL_VAULT_ADDRESS=

#############################################
# API (apps/api) — server-only. NEVER exposed to the browser.
#############################################
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (CORS allowlist).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Rate limiting (baseline).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Max request body size in bytes.
BODY_LIMIT_BYTES=1048576
# Session signing secret (min 32 chars). Generate a random value; keep secret.
SESSION_SECRET=
# Operator allowlist (comma-separated wallet addresses). Empty = no operator yet.
OPERATOR_ALLOWLIST=

#############################################
# Supabase — database & auth foundation
#############################################
SUPABASE_URL=
# Anon key is safe for the browser; expose via NEXT_PUBLIC_SUPABASE_ANON_KEY when needed.
SUPABASE_ANON_KEY=
# Service role key is a SECRET. Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Pooled Postgres connection string (Supabase). Server-only secret.
DATABASE_URL=

#############################################
# KeeperHub (server-only) — filled in Phase 3
#############################################
# Organization API key (kh_...) with broadcast/write scope. SECRET. Server-side
# only; never logged (apps/api/src/lib/keeperhub redacts it from every error).
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://app.keeperhub.com
# Workflow that calls pause() on the real protected DemoVault (0x429F...5fB4B).
# Create it in the KeeperHub console: Web3 "Write Contract" step, abiFunction
# "pause", network 84532, manual trigger, disabled at rest. See PHASE-3-RESULTS.md.
KEEPERHUB_GUARDIAN_WORKFLOW_ID=

#############################################
# Base Sepolia RPC (server-only) — filled in Phase 2/3
#############################################
BASE_SEPOLIA_RPC_HTTP=
BASE_SEPOLIA_RPC_WS=

#############################################
# apps/api Phase 3 live proof (scripts/phase3-live-proof.ts) — optional
#############################################
# Overrides the deployed-contract defaults baked into apps/api/src/lib/chain/env.ts
# (the real Phase 2 addresses). Only needed to point at a different deployment.
# INTENT_REGISTRY_ADDRESS=
# MOCK_ASSET_ADDRESS=
# PROTECTED_VAULT_ADDRESS=
# CONTROL_VAULT_ADDRESS=
# Agent/receiver used by the live proof. Defaults to the KeeperHub sender wallet.
# AGENT_ADDRESS=
# If set, the live proof restores the protected vault to unpaused afterward via a
# direct admin unpause() call (packages/contracts/.env's DEPLOYER_PRIVATE_KEY works
# here too — same wallet holds DEFAULT_ADMIN_ROLE). SECRET if set.
# DEPLOYER_PRIVATE_KEY=
# Reuse across retries of a failed live-proof attempt so idempotency keys stay
# stable instead of risking a second real transaction for the same step.
# CHAINSRE_RUN_ID=
# Only the real write path checks this. Leave unset for a safe dry run.
# CONFIRM_BROADCAST=

#############################################
# Contracts (packages/contracts) — Base Sepolia deployment
#############################################
# Deployer key used by `script/Deploy.s.sol`. SECRET. Never commit a real value and
# never echo it; the deploy script reads it and never prints it.
DEPLOYER_PRIVATE_KEY=
# DEFAULT_ADMIN_ROLE holder on both vaults. Optional; defaults to the deployer.
VAULT_ADMIN=
# MINTER_ROLE holder — the agent's KeeperHub execution wallet. Public address.
VAULT_MINTER=
# GUARDIAN_ROLE holder — the sender the KeeperHub pause workflow uses. Public address.
VAULT_GUARDIAN=
# Assets seeded into EACH vault, in 18-decimal units. Default is 1,000,000e18.
SEED_ASSETS=1000000000000000000000000
# Optional, only for `forge verify-contract` on BaseScan.
BASESCAN_API_KEY=
# Deployed addresses (filled after Phase 2 deployment). Public, non-secret.
MOCK_ASSET_ADDRESS=

#############################################
# Demo tuning (later phases)
#############################################
ATTACK_WINDOW_MS=8000
CONFIRMATION_COUNT=1
