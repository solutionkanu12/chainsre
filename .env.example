# ChainSRE — environment template. Copy to `.env` (and per-app `.env.local`) and fill values.
# NEVER commit a real .env. Only this .env.example (placeholders) is tracked by Git.

#############################################
# Shared / network
#############################################
# Active chain for the MVP demo. Base Sepolia = 84532. Registry is multi-chain ready.
CHAIN_ID=84532

#############################################
# Web (apps/web) — PUBLIC values only. These are exposed to the browser bundle.
#############################################
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org
# Deployed contract addresses (filled in Phase 2). Public, non-secret.
NEXT_PUBLIC_INTENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_PROTECTED_VAULT_ADDRESS=
NEXT_PUBLIC_CONTROL_VAULT_ADDRESS=

#############################################
# API (apps/api) — server-only. NEVER exposed to the browser.
#############################################
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (CORS allowlist).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Rate limiting (baseline).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Max request body size in bytes.
BODY_LIMIT_BYTES=1048576
# Session signing secret (min 32 chars). Generate a random value; keep secret.
SESSION_SECRET=
# Operator allowlist (comma-separated wallet addresses). Empty = no operator yet.
OPERATOR_ALLOWLIST=

#############################################
# Supabase — database & auth foundation
#############################################
SUPABASE_URL=
# Anon key is safe for the browser; expose via NEXT_PUBLIC_SUPABASE_ANON_KEY when needed.
SUPABASE_ANON_KEY=
# Service role key is a SECRET. Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Pooled Postgres connection string (Supabase). Server-only secret.
DATABASE_URL=

#############################################
# KeeperHub (server-only) — filled in Phase 3
#############################################
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_GUARDIAN_WORKFLOW_ID=

#############################################
# Base Sepolia RPC (server-only) — filled in Phase 2/3
#############################################
BASE_SEPOLIA_RPC_HTTP=
BASE_SEPOLIA_RPC_WS=

#############################################
# Demo tuning (later phases)
#############################################
ATTACK_WINDOW_MS=8000
CONFIRMATION_COUNT=1
