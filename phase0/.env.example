# ChainSRE — Phase 0 verification environment (EXAMPLE — no real secrets here)
#
# Copy this file to `.env` and fill in real values in your LOCAL .env only.
# NEVER commit a real .env. NEVER paste real keys into chat, screenshots, or source.
#
#   cp .env.example .env
#   # edit .env, then:  set -a; source .env; set +a
#
# The scripts read these from the environment. They redact secrets in all output.

# --- KeeperHub -------------------------------------------------------------
# Base URL for the KeeperHub API. CONFIRMED correct. Do NOT append /api here —
# the paths below already include it (a doubled /api/api causes a 404).
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# Organization API key — a `kh_...` key from Settings > API Keys > Organisation.
# Sent as `Authorization: Bearer kh_...`. Server-side ONLY. Keep out of git.
# Broadcasting needs mcp:write scope; a dry run only needs mcp:read.
KEEPERHUB_API_KEY=

# Endpoint paths CONFIRMED against docs.keeperhub.com. Override only if the API
# changes. (For chain discovery incl. disabled: /api/chains?includeDisabled=true)
KEEPERHUB_CHAINS_PATH=/api/chains
KEEPERHUB_CONTRACT_CALL_PATH=/api/execute/contract-call
KEEPERHUB_EXECUTION_STATUS_PATH=/api/execute/{executionId}/status
KEEPERHUB_WORKFLOW_EXECUTE_PATH=/api/workflows/{workflowId}/execute
KEEPERHUB_WORKFLOW_STATUS_PATH=/api/workflows/executions/{executionId}/status

# Guardian workflow that calls pause(). Created + tested in KeeperHub UI first.
# In the Web3 "Write Contract" step, use keys abiFunction:"pause", functionArgs:"[]".
KEEPERHUB_GUARDIAN_WORKFLOW_ID=

# --- Base Sepolia ----------------------------------------------------------
CHAIN_ID=84532
BASE_SEPOLIA_RPC_HTTP=

# The KeeperHub execution wallet address (for recording / readiness, not a secret).
KEEPERHUB_WALLET_ADDRESS=

# --- Harmless-call target (Phase 0 only) -----------------------------------
# A throwaway target + function for the ONE harmless real testnet write.
# Prefer a trivial, no-value, non-destructive call on a contract you control.
HARMLESS_TARGET_ADDRESS=
HARMLESS_FUNCTION_NAME=
HARMLESS_FUNCTION_ARGS=[]

# --- Safety switch ---------------------------------------------------------
# Real broadcasts and workflow triggers refuse to run unless this is exactly "yes".
# Leave empty for simulation / dry-run.
CONFIRM_BROADCAST=
